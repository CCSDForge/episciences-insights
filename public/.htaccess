# Episciences Insights - Apache .htaccess configuration

Options -Indexes +FollowSymLinks
DirectoryIndex index.html

# 404 handler
ErrorDocument 404 /404.html

# -------------------------------------------------------------
# 1. SERVIR LES FICHIERS PRÉ-COMPRESSÉS (.br et .gz)
# -------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Servir Brotli en priorité si le navigateur le supporte
    RewriteCond %{HTTP:Accept-Encoding} br
    RewriteCond %{REQUEST_FILENAME}.br -f
    RewriteRule ^(.*)$ $1.br [L]

    # Sinon servir Gzip si supporté
    RewriteCond %{HTTP:Accept-Encoding} gzip
    RewriteCond %{REQUEST_FILENAME}.gz -f
    RewriteRule ^(.*)$ $1.gz [L]
</IfModule>

<IfModule mod_headers.c>
    # En-têtes pour les fichiers pré-compressés Brotli
    <Files *.json.br>
        ForceType application/json
        Header set Content-Encoding br
        Header append Vary Accept-Encoding
    </Files>

    # En-têtes pour les fichiers pré-compressés Gzip
    <Files *.json.gz>
        ForceType application/json
        Header set Content-Encoding gzip
        Header append Vary Accept-Encoding
    </Files>
</IfModule>

# -------------------------------------------------------------
# 2. COMPRESSION DYNAMIQUE À LA VOLÉE (HTML, JS, CSS, SVG)
# -------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/json image/svg+xml
</IfModule>

# -------------------------------------------------------------
# 3. MISE EN CACHE DU NAVIGATEUR
# -------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # Fichiers Next.js immuables (_next/static/) : 1 an
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"

    # Fichiers de données (publications.json) : revalidation systématique
    ExpiresByType application/json "access plus 0 seconds"

    # Fichiers HTML : revalidation immédiate
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Cache immutable pour les fichiers générés avec hash (_next/static)
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Données JSON : toujours revalider pour que les mises à jour soient immédiates
    <FilesMatch "\.json(\.gz|\.br)?$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # HTML
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>
