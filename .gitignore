# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
*.tar.bz2
*.tar.gz

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.preprod.local.example
!.env.production.local.example

# Ansible & Ansistrano secrets
/deployment/ansible/inventory/*.ini
!/deployment/ansible/inventory/*.ini.example
/deployment/ansible/group_vars/**/secrets.yml
!/deployment/ansible/group_vars/**/secrets.yml.example
/deployment/ansible/roles/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/.cache/
/publications.csv
/tmp/
/.idea/

# Agent specific files
AGENTS.md
CLAUDE.md
GEMINI.md
/logs/
/.claude/
/kpi_downloads.json

# Generated data
/public/data/*.json
/public/data/*.gz
/public/data/*.br
!/public/data/.gitkeep

# Generated geo assets from world-atlas
/public/geo/*
!/public/geo/.gitkeep
